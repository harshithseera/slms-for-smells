+    def _is_outside_week(self, gc: GymClass, week_start: datetime, week_end: datetime) -> bool:
+        return gc.start < week_start or gc.start >= week_end
+
+    def _check_trainer_and_room(self, gc: GymClass, trainers: dict[str, Trainer]) -> tuple[Trainer | None, str | None]:
+        trainer = trainers.get(gc.trainer_id)
+        if trainer is None:
+            return None, f"{gc.class_id}: unknown trainer {gc.trainer_id}"
+        if gc.room not in self.rooms:
+            return None, f"{gc.class_id}: unknown room {gc.room}"
+        return trainer, None
+
+    def _adjust_capacity(self, gc: GymClass) -> tuple[GymClass, str | None]:
+        room_cap = self.rooms[gc.room]
+        if gc.capacity > room_cap:
+            return replace(gc, capacity=room_cap), f"{gc.class_id}: capacity {gc.capacity} > room {room_cap}, capped"
+        return gc, None
+
+    def _find_room_clash(self, gc: GymClass, slot: TimeSlot, by_room: dict[str, list[GymClass]]) -> GymClass | None:
+        for other in by_room.get(gc.room, []):
+            if slot.overlaps(TimeSlot.of(other.start, other.duration_min)):
+                return other
+        return None
+
+    def _is_trainer_busy(self, gc: GymClass, slot: TimeSlot, accepted: list[GymClass]) -> bool:
+        for other in accepted:
+            if other.trainer_id == gc.trainer_id:
+                if slot.overlaps(TimeSlot.of(other.start, other.duration_min)):
+                    return True
+        return False
+
