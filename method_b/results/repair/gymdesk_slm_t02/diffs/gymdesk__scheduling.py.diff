+    def _check_week_bounds(self, gc: GymClass, week_start: datetime, week_end: datetime) -> str | None:
+        if gc.start < week_start or gc.start >= week_end:
+            return f"{gc.class_id}: outside week"
+        return None
+
+    def _check_trainer_and_room(self, gc: GymClass, trainers: dict[str, Trainer]) -> tuple[Trainer | None, str | None]:
+        trainer = trainers.get(gc.trainer_id)
+        if trainer is None:
+            return None, f"{gc.class_id}: unknown trainer {gc.trainer_id}"
+        if gc.room not in self.rooms:
+            return None, f"{gc.class_id}: unknown room {gc.room}"
+        return trainer, None
+
+    def _adjust_capacity(self, gc: GymClass) -> tuple[GymClass, str | None]:
+        room_cap = self.rooms[gc.room]
+        if gc.capacity > room_cap:
+            warning = f"{gc.class_id}: capacity {gc.capacity} > room {room_cap}, capped"
+            return replace(gc, capacity=room_cap), warning
+        return gc, None
+
+    def _check_conflicts(
+        self,
+        gc: GymClass,
+        trainer: Trainer,
+        accepted: list[GymClass],
+        by_room: dict[str, list[GymClass]],
+        per_trainer: dict[str, int],
+    ) -> str | None:
+        slot = TimeSlot.of(gc.start, gc.duration_min)
+        
+        for other in by_room.get(gc.room, []):
+            if slot.overlaps(TimeSlot.of(other.start, other.duration_min)):
+                return f"{gc.class_id}: room {gc.room} taken by {other.class_id}"
+
+        for other in accepted:
+            if other.trainer_id == gc.trainer_id and slot.overlaps(TimeSlot.of(other.start, other.duration_min)):
+                return f"{gc.class_id}: trainer {trainer.name} double-booked"
+
+        count = per_trainer.get(gc.trainer_id, 0)
+        if count >= trainer.max_classes_per_week:
+            return f"{gc.class_id}: trainer {trainer.name} over weekly limit"
+
+        return None
+
