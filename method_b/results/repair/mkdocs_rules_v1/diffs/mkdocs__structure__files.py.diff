+def _filter_paths_file(basename: str, path: str, exclude: Iterable[str]) -> bool:
+    for item in exclude:
+        if item.endswith('/'):
+            continue
+        match = path if item.startswith('/') else basename
+        if fnmatch.fnmatch(match, item.strip('/')):
+            return True
+    return False
+
+
+def _filter_paths_dir(basename: str, path: str, exclude: Iterable[str]) -> bool:
+    for item in exclude:
+        match = path if item.startswith('/') else basename
+        if fnmatch.fnmatch(match, item.strip('/')):
+            return True
+    return False
+
