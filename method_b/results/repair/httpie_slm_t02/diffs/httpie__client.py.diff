+def _get_or_create_httpie_session(context: RequestContext):
+    args = context.args
+    env = context.env
+    if args.session or args.session_read_only:
+        return get_httpie_session(
+            env=env,
+            config_dir=env.config.directory(),
+            session_name=args.session or args.session_read_only,
+            host=args.headers.get('Host'),
+            url=args.url,
+        )
+    return None
+
+
+def _update_httpie_session_with_request(httpie_session, request_kwargs, args):
+    httpie_session.update_headers(request_kwargs['headers'])
+    if args.auth_plugin:
+        httpie_session.auth = {
+            'type': args.auth_plugin.auth_type(),
+            'raw_auth': args.auth_plugin.raw_auth(),
+        }
+    elif httpie_session.auth:
+        request_kwargs['auth'] = httpie_session.auth
+
+
+def _save_httpie_session(httpie_session, requests_session, expired_cookies, args):
+    if httpie_session.is_new() or not args.session_read_only:
+        httpie_session.cookies = requests_session.cookies
+        httpie_session.remove_cookies(expired_cookies)
+        httpie_session.save()
 
 
