+def _parse_format_option_tokens(option: str):
+    try:
+        path, value = option.lower().split(':')
+        section, key = path.split('.')
+        return section, key, path, value
+    except ValueError:
+        raise argparse.ArgumentTypeError(f'invalid option {option!r}')
+
+
+def _parse_format_option_value(value: str):
+    value_map = {
+        'true': True,
+        'false': False,
+    }
+    if value in value_map:
+        return value_map[value]
+    if value.isnumeric():
+        return int(value)
+    return value
+
+
+def _validate_and_get_format_value(defaults, section, key, path, value, parsed_value, option):
+    if defaults is None:
+        return parsed_value
+
+    try:
+        default_value = defaults[section][key]
+    except KeyError:
+        raise argparse.ArgumentTypeError(f'invalid key {path!r}')
+
+    default_type, parsed_type = type(default_value), type(parsed_value)
+    if parsed_type is not default_type:
+        raise argparse.ArgumentTypeError(
+            'invalid value'
+            f' {value!r} in {option!r}'
+            f' (expected {default_type.__name__}'
+            f' got {parsed_type.__name__})'
+        )
+    return parsed_value
+
+
