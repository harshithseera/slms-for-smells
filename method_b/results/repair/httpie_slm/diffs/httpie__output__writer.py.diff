+def write_stream_flush(params: WriteStreamParams):
+    """Write the output stream with flushing."""
+    try:
+        buf = params.outfile.buffer
+    except AttributeError:
+        buf = params.outfile
+
+    for chunk in params.stream:
+        buf.write(chunk)
+        params.outfile.flush()
+
