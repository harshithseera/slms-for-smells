+    elif isinstance(raw_body, RequestDataDict):
+        body = as_bytes(urlencode(raw_body, doseq=True))
+    else:
+        body = raw_body
+
+    if is_file_like:
+        return _prepare_file_for_upload(
+            upload_context.env,
+            body,
+            chunked=upload_context.chunked,
+            callback=body_read_callback,
+            content_length_header_value=upload_context.content_length_header_value
+        )
+    elif upload_context.chunked:
+        return ChunkedUploadStream(
+            stream=iter([body]),
+            callback=body_read_callback
+        )
+    else:
