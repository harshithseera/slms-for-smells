+def _parse_format_option_value(value: str) -> Union[bool, int, str]:
+    value_map = {
+        'true': True,
+        'false': False,
+    }
+    if value in value_map:
+        return value_map[value]
+    if value.isnumeric():
+        return int(value)
+    return value
+
+
+def _apply_format_option(options: dict, option: str, defaults: Optional[dict]) -> None:
+    try:
+        path, raw_value = option.lower().split(':')
+        section, key = path.split('.')
+    except ValueError:
+        raise argparse.ArgumentTypeError(f'invalid option {option!r}')
+
+    parsed_value = _parse_format_option_value(raw_value)
+
+    if defaults is None:
+        options.setdefault(section, {})
+    else:
+        try:
+            default_value = defaults[section][key]
+        except KeyError:
+            raise argparse.ArgumentTypeError(f'invalid key {path!r}')
+
+        default_type, parsed_type = type(default_value), type(parsed_value)
+        if parsed_type is not default_type:
+            raise argparse.ArgumentTypeError(
+                'invalid value'
+                f' {raw_value!r} in {option!r}'
+                f' (expected {default_type.__name__}'
+                f' got {parsed_type.__name__})'
+            )
+
+    options[section][key] = parsed_value
+
