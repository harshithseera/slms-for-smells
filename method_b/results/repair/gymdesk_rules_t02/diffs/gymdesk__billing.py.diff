+@dataclass(frozen=True)
+class Currency:
+    code: str
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "code", self.code.strip().upper())
+        if self.code not in EUR_RATES:
+            raise ValueError(f"unsupported currency {self.code!r}")
+
+    def format(self, amount: float) -> str:
+        return f"{round(amount, 2):.2f} {self.code}"
+
+    def convert_from(self, amount: float, other: Currency) -> float:
+        if other.code not in EUR_RATES:
+            raise ValueError(f"unsupported currency {other.code!r}")
+        return round(amount / EUR_RATES[other.code] * EUR_RATES[self.code], 2)
+
