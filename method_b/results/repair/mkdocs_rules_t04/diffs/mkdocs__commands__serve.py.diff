     from mkdocs.config.defaults import MkDocsConfig
 
 log = logging.getLogger(__name__)
+
+DEFAULT_ERROR_CODES = (404, 500)
+
+
+@dataclass
+class ServeOptions:
+    config_file: str | None = None
+    livereload: bool = True
+    build_type: str | None = None
+    watch_theme: bool = False
+    watch: list[str] = None
+    open_in_browser: bool = False
+    kwargs: dict = None
+
+    def __post_init__(self):
+        if self.watch is None:
+            self.watch = []
+        if self.kwargs is None:
+            self.kwargs = {}
+
+
+def _get_error_page_content(site_dir: str, code: int) -> bytes | None:
+    if code not in DEFAULT_ERROR_CODES:
+        return None
+    error_page = join(site_dir, f'{code}.html')
+    if not isfile(error_page):
+        return None
+    with open(error_page, 'rb') as f:
+        return f.read()
+
+
+def _setup_livereload_watches(server: LiveReloadServer, config: MkDocsConfig, watch_theme: bool) -> None:
+    server.watch(config.docs_dir)
+    if config.config_file_path:
+        server.watch(config.config_file_path)
+
+    if watch_theme:
+        for d in config.theme.dirs:
+            server.watch(d)
+
+    for item in config.watch:
+        server.watch(item)
+
+
+def _run_server(server: LiveReloadServer, open_in_browser: bool) -> None:
+    try:
+        server.serve(open_in_browser=open_in_browser)
+    except KeyboardInterrupt:
+        log.info("Shutting down...")
+    finally:
+        server.shutdown()
 
 
