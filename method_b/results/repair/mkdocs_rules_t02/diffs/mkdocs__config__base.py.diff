+def _validate_helper(self: Config, validation_method_name: str) -> tuple[ConfigErrors, ConfigWarnings]:
+    failed: ConfigErrors = []
+    warnings: ConfigWarnings = []
+
+    for key, config_option in self._schema:
+        try:
+            method = getattr(config_option, validation_method_name)
+            if validation_method_name == 'validate':
+                value = self.get(key)
+                self[key] = method(value)
+            else:
+                method(self, key_name=key)
+            warnings.extend((key, w) for w in config_option.warnings)
+            config_option.reset_warnings()
+            if validation_method_name == 'validate':
+                pass # validate loop breaks on exception per item
+        except ValidationError as e:
+            failed.append((key, e))
+            if validation_method_name == 'validate':
+                break
+
+    if validation_method_name == 'validate':
+        for key in set(self.keys()) - self._schema_keys:
+            warnings.append((key, f"Unrecognised configuration name: {key}"))
+
+    return failed, warnings
+
