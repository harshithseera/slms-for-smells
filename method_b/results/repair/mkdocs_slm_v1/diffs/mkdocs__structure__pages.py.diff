+@dataclasses.dataclass
+class _ParsedURL:
+    scheme: str
+    netloc: str
+    path: str
+    query: str
+    anchor: str
+    original_url: str
+
+    @classmethod
+    def from_url(cls, url: str) -> _ParsedURL:
+        scheme, netloc, path, query, anchor = urlsplit(url)
+        return cls(
+            scheme=scheme,
+            netloc=netloc,
+            path=urlunquote(path),
+            query=query,
+            anchor=anchor,
+            original_url=url,
+        )
+
+    def unsplit(self, path: str | None = None) -> str:
+        return urlunsplit(('', '', path if path is not None else self.path, self.query, self.anchor))
 
 
