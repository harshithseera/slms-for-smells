+    def _validate_class_time(self, gc: GymClass, week_start: datetime, week_end: datetime) -> str | None:
+        if gc.start < week_start or gc.start >= week_end:
+            return f"{gc.class_id}: outside week"
+        return None
+
+    def _validate_trainer(self, gc: GymClass, trainers: dict[str, Trainer]) -> tuple[Trainer | None, str | None]:
+        trainer = trainers.get(gc.trainer_id)
+        if trainer is None:
+            return None, f"{gc.class_id}: unknown trainer {gc.trainer_id}"
+        return trainer, None
+
+    def _validate_room(self, gc: GymClass) -> str | None:
+        if gc.room not in self.rooms:
+            return f"{gc.class_id}: unknown room {gc.room}"
+        return None
+
+    def _check_conflicts(self, gc: GymClass, by_room: dict[str, list[GymClass]], accepted: list[GymClass], trainers: dict[str, Trainer], per_trainer: dict[str, int]) -> str | None:
+        slot = TimeSlot.of(gc.start, gc.duration_min)
